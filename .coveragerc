[run]
# Mede também os caminhos de cada decisão (os dois lados de cada if), não só as linhas
branch = True
source = application
         scripts
         interfaces
         infrastructure
         config
omit = 
    tailwind.config.js
    */migrations/*
    */tests/*
    manage.py
    */wsgi.py
    */asgi.py
[report]
# Abaixo de 100% o comando falha (no CI e no make test)
fail_under = 100
