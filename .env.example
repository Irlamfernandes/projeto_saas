# Copie para .env e preencha. Nunca versione o .env.

# Desenvolvimento local: True. Em produção deixe vazio/False (liga HTTPS, cookies seguros e HSTS).
DJANGO_DEBUG=True
# Hosts separados por vírgula (ex.: meu-app.onrender.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Obrigatória com DJANGO_DEBUG desligado. Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Postgres (Supabase). Vazio = SQLite local (db.sqlite3).
DATABASE_URL=
# DATABASE_SSL_REQUIRE=True   # padrão: True quando DATABASE_URL está definido

# Supabase Storage (upload das imagens de produtos)
SUPABASE_URL=
SUPABASE_KEY=

# Mercado Pago (Pix da renovação do plano). TEST-... gera Pix de teste; APP_USR-... cobra de verdade.
MERCADO_PAGO_ACCESS_TOKEN=

# Opcionais de segurança (valem só com DJANGO_DEBUG desligado)
# DJANGO_SECURE_SSL_REDIRECT=True   # False apenas se rodar sem HTTPS (ex.: docker local em modo produção)
# DJANGO_HSTS_SECONDS=31536000      # padrão: 1 ano (o site só abre por HTTPS)

# Backup: senha que criptografa os arquivos (guarde também fora daqui!) e token do agendador (/interno/backup/)
BACKUP_CHAVE=
BACKUP_TOKEN=
